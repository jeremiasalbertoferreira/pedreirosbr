# Banco (Coolify provisiona Postgres e injeta)
DATABASE_URL="postgresql://user:senha@host:5432/pedreirosbr"

# Vertical ativa (multi-profissão: hoje só existe "pedreiro")
OFICIO_SLUG="pedreiro"

# Monetização — deixar vazio até as contas serem aprovadas.
# Site fica limpo (sem anúncios) enquanto vazio.
NEXT_PUBLIC_ADSENSE_CLIENT=""
NEXT_PUBLIC_ADSENSE_SLOT=""

# Afiliados
TAG_AMAZON=""

# WhatsApp — Meta Cloud API (setup: docs/WHATSAPP_META_SETUP.md)
# Vazio = envio desabilitado (no-op), site funciona normal sem isso.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_PUBLIC_NUMBER="5511952133575"
WHATSAPP_TEMPLATE_NAME="resultado_calculadora_obra"
WHATSAPP_TEMPLATE_CONVITE="convite_territorio"
WHATSAPP_TEMPLATE_LEAD="novo_lead"
WHATSAPP_VERIFY_TOKEN=""
# Segredo do APP PedreirosBR (não é o token de acesso nem o verify token).
WHATSAPP_APP_SECRET=""
# Token independente, aleatório, para o worker interno (não publicar).
INTERNAL_JOB_TOKEN=""

# Asaas — cobrança da assinatura de território (docs §10)
# Vazio = sem link de pagamento automático (cobrança manual até configurar).
ASAAS_API_KEY=""
ASAAS_ENV="sandbox"
# Só habilitar após canário sandbox, reconciliação e validação comercial.
ASAAS_BILLING_ENABLED="false"
ASAAS_VALOR_ASSINATURA="97"
ASAAS_WEBHOOK_TOKEN=""
