// PedreirosBR — banco do organismo
// Postgres (Coolify). DNA da Fase 2 (leads pagos) já nasce aqui.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Território: cidade ou bairro. Páginas nascem quando os contadores cruzam o limiar.
model Territory {
  id         String   @id @default(cuid())
  tipo       String   // "cidade" | "bairro"
  slug       String   @unique // ex.: "osasco-sp" ou "osasco-sp/jardim-rosa"
  nome       String
  uf         String
  ibge       String?
  // contadores do organismo (atualizados a cada evento)
  calculos   Int      @default(0)
  buscas     Int      @default(0)
  leads      Int      @default(0)
  orcamentos Int      @default(0)
  // estado da página no organismo
  paginaAtiva  Boolean @default(false) // nasce true só após limiar de substância
  assinaturaAtiva Boolean @default(false) // fase 2: organismo passou a oferecer assinatura
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([uf, tipo])
}

/// Log imutável de eventos — matéria-prima do flywheel de dados.
model TerritoryEvent {
  id          String   @id @default(cuid())
  territorySlug String
  tipo        String   // "calculo" | "busca" | "lead" | "orcamento_pdf" | "avaliacao"
  servico     String?  // slug da calculadora
  meta        Json?
  createdAt   DateTime @default(now())

  @@index([territorySlug, createdAt])
  @@index([tipo, createdAt])
}

/// Lead capturado (cliente que precisa de obra). Geolocalizado desde o dia 1.
model Lead {
  id          String   @id @default(cuid())
  servico     String
  descricao   String?
  territorySlug String
  whatsapp    String
  origem      String   // "calculadora" | "orcamento_pdf" | "pagina_cidade"
  resultado   Json?    // snapshot do cálculo que originou o lead
  distribuido Boolean  @default(false)
  createdAt   DateTime @default(now())
  verifiedAt DateTime?
  consentAt DateTime?
  consentVersion String?
  deliveryState String @default("PENDING_VERIFICATION")

  @@index([territorySlug, createdAt])
}

/// Profissional — base de oferta (fase 2). Nasce vazia, preenche pelos loops 5.1/5.2/5.3.
model Professional {
  id          String   @id @default(cuid())
  nome        String
  whatsapp    String   @unique
  cpf         String?  // exigido pelo Asaas para cobrança (LGPD: só para billing)
  slug        String?  @unique // página pública futura: /joao-osasco
  territorySlug String
  oficio      String   @default("pedreiro")
  origem      String?  // "ferramenta" | "avaliacao_cliente" | "claim"
  status      String   @default("capturado") // "capturado" | "pagina_ativa" | "assinante"
  avaliacaoMedia Float?
  avaliacoes   Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  billing     BillingSubscription?
  verifiedAt DateTime?
  consentAt DateTime?
  consentVersion String?
}

model VerificationRequest {
  tokenHash String @id
  kind String
  whatsapp String
  data Json
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  @@index([whatsapp, createdAt])
}

model TerritorySeat {
  territorySlug String @id
  professionalId String @unique
  createdAt DateTime @default(now())
}

model OutboundMessage {
  key String @id
  recipient String
  kind String // TEXT | LEAD | INVITE | BILLING
  payload Json
  state String @default("PENDING") // PENDING | SENDING | SENT | DELIVERED | REVIEW
  messageId String? @unique
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([state, nextAttemptAt])
}

model RequestLimit {
  key String @id
  count Int @default(1)
  expiresAt DateTime
}

// Callbacks podem chegar antes de a resposta do POST de envio ser persistida.
model MessageDelivery {
  messageId String @id
  state String // DELIVERED | FAILED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([createdAt])
}

/// Registro durável anterior a qualquer POST financeiro. Nunca apagar para tentar novamente.
model BillingSubscription {
  professionalId String @id
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  territorySlug String
  environment String
  state String @default("CREATING") // CREATING | READY | REVIEW | CANCELLED
  customerId String?
  subscriptionId String? @unique
  activePaymentId String?
  latestPaymentId String?
  latestPaymentDueDate String?
  overdueSince String?
  payments BillingPayment[]
  lastEventCreated String?
  cancellationState String? // REQUESTED | PROCESSING | SUBMITTED | REVIEW | CONFIRMED
  cancellationRequestedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Histórico técnico por fatura: um evento atrasado não pode substituir outro ciclo.
model BillingPayment {
  paymentId String @id
  professionalId String
  billing BillingSubscription @relation(fields: [professionalId], references: [professionalId], onDelete: Restrict)
  dueDate String
  state String // PAID | OVERDUE | REFUNDED | DELETED
  lastEventCreated String
  updatedAt DateTime @updatedAt
  @@index([professionalId, dueDate])
}

/// Sem conteúdo de mensagem, CPF ou token. PROCESSING abandonado requer reconciliação.
model WebhookReceipt {
  provider String
  eventId String
  state String @default("PROCESSING") // PROCESSING | FAILED | DONE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@id([provider, eventId])
  @@index([state, updatedAt])
}
